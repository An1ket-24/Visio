<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Ship the template + samples beside the binary so they resolve from any working directory. -->
    <EnableDefaultNoneItems>true</EnableDefaultNoneItems>
  </PropertyGroup>

  <ItemGroup>
    <None Include="templates/blank.vsdx" CopyToOutputDirectory="PreserveNewest" />
    <None Update="templates/README.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="samples/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
